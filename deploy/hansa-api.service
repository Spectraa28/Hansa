# One API process, as the import queue and the job runner both require.
[Unit]
Description=Hansa API
After=network-online.target docker.service
Wants=network-online.target
Requires=docker.service

[Service]
User=hansa
WorkingDirectory=/opt/hansa/backend
ExecStart=/opt/hansa/backend/.venv/bin/uvicorn app.main:create_app --factory --host 127.0.0.1 --port 8000 --no-access-log
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
