# Terminates HTTPS for the API and passes requests to the one local API process.
# Replace HANSA_API_HOST with the API's name, for example hansa-api.sverma.online. setup-server.sh does this for you.
HANSA_API_HOST {
	encode gzip
	header -Server
	# Only the two path groups the website uses are reachable from outside. The model gateway and
	# everything else stay on the machine: the sandbox reaches the gateway over a local relay.
	@public path /auth/* /github/*
	handle @public {
		reverse_proxy 127.0.0.1:8000
	}
	handle {
		respond 404
	}
}
