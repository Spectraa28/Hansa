# Use the SDK project key from Neatlogs Settings > API keys.
# The nlw_ HTTP ingest key is not the SDK project key.
NEATLOGS_API_KEY=

# Generate locally with: openssl rand -hex 32
AUTH_SECRET_KEY=
AUTH_DATABASE_PATH=var/auth.sqlite3
APP_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:5173
# Set true together with an HTTPS APP_URL when hosted.
AUTH_COOKIE_SECURE=false
AUTH_EMAIL_LOGIN_ENABLED=true

# OAuth app credentials; leave blank to disable that provider.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Separate GitHub App for repository imports (not the identity-only OAuth App).
# Configure Contents: read and Metadata: read, and select permitted repositories.
GITHUB_APP_ID=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
# Store the downloaded RSA PEM key in ignored var/ or outside the repository.
GITHUB_APP_PRIVATE_KEY_PATH=
# Local value: http://localhost:8000/github/callback
GITHUB_APP_CALLBACK_URL=
# Fernet key generated locally; never store this key in SQLite.
GITHUB_TOKEN_ENCRYPTION_KEY=
# Required for hosted imports; register APP_URL + /github/webhook with GitHub.
GITHUB_WEBHOOK_SECRET=
IMPORT_WORKSPACE_PATH=var/imports
IMPORT_DOWNLOAD_BYTES=104857600
IMPORT_EXTRACTED_BYTES=524288000
IMPORT_FILE_COUNT=20000
IMPORT_TIMEOUT_SECONDS=120

# OpenAI-compatible LiteLLM API root, including /v1 if the endpoint requires it.
# Both values are required to enable the gateway. Server-only real key.
LITELLM_BASE_URL=
LITELLM_API_KEY=

# Baseline runs may reach the public web through the filtering egress sidecar (see RUNNER.md).
# Set false to keep runs fully offline.
RUNNER_INTERNET=true
